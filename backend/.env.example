# Copy to backend/.env (or export in your shell). Without a key, datasurge
# uses template-based summaries so the demo still works offline.
ANTHROPIC_API_KEY=
# Optional overrides
# DATASURGE_MODEL=claude-opus-5-5
# DATASURGE_EFFORT=low
# DATASURGE_LLM=off

GEMINI_API_KEY=
# Used only when the primary model is overloaded or times out.
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
